# Server
NODE_ENV=development
PORT=3001

# Database — Vercel Postgres (auto-set when linked)
# For local dev, use Docker Compose PostgreSQL:
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/genx?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/genx?schema=public"

# Redis — Vercel KV (auto-set when linked)
# For local dev, use Docker Compose Redis:
KV_URL="redis://localhost:6379"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# CORS (not needed on Vercel — same origin)
CLIENT_URL="http://localhost:5173"

# Worker Settings (local only — Vercel uses serverless processing)
WORKER_CONCURRENCY=5
MAX_RETRIES=3
